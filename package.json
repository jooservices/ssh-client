{
  "name": "@jooservices/ssh-client",
  "version": "1.1.0",
  "description": "Node 24 SSH client library — interactive shell sessions, host-key pinning, usable from any app.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage && node tools/check-per-file-coverage.mjs",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit",
    "test:consumer": "node tools/consumer-smoke.mjs",
    "test:e2e": "bash tools/e2e.sh",
    "audit:prod": "npm audit --omit=dev",
    "ci": "npm run audit:prod && npm run lint && npm run typecheck:tests && npm run test:coverage && npm run build && npm run test:consumer"
  },
  "dependencies": {
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ssh2": "^1.15.6",
    "@vitest/coverage-v8": "^5.0.0",
    "fast-check": "^4.10.2",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
