{
  "name": "@jooservices/ssh-client",
  "version": "0.5.0",
  "description": "Node 24 SSH client library — interactive shell sessions, host-key pinning, usable from any app.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bash tools/e2e.sh",
    "ci": "npm run lint && npm run test:coverage && npm run build"
  },
  "dependencies": {
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ssh2": "^1.15.6",
    "@vitest/coverage-v8": "^5.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
